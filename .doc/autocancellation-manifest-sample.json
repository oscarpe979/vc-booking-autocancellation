    "events": [
      {
        "path": "UserInterface.Message.Prompt.Response",
        "access": "required"
      },
      {
        "path": "UserInterface.Message.Prompt.Cleared",
        "access": "required"
      },
      {
        "path": "BootEvent",
        "access": "optional"
      },
      {
        "path": "Bookings.Start",
        "access": "optional"
      },
      {
        "path": "Bookings.End",
        "access": "optional"
      },
      {
        "path": "Bookings.Deleted",
        "access": "optional"
      }
    ]
